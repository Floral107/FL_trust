# single quarantine for everything retired: box snapshots + per-host scripts,
# one-off analyses, superseded builders, tarball pulls, data backups, old notes,
# the short paper, and the standalone demo app (which lives in its own repo).
# Nothing in here is part of the pipeline; nothing in here may be re-run.
archive/

# paper/ IS shipped (gate, table/figure builders, thesis splicers) so the
# commands in PIPELINE.md work on a fresh clone. Run them from the repo ROOT,
# e.g. `python paper/sanity_gate.py` — the scripts use cwd-relative data/ paths
# on purpose.
Code/paper/__pycache__/

# internal working documents; the root README is the single doc
AUDIT.md
REPO_MAP.md
PIPELINE.md
Code/data/README.md
*/README.md

# raw per-seed result CSVs (already merged into data/combo/)
Code/results_*.csv

# generated table bodies (paper/ builders write these to the repo root, and the
# paper/_splice_*.py scripts read them from there)
Code/tab*.tex

# scratch figures written by Code/paper/_run_figs.py are ignored;
# the finals used by the manuscripts live under LaTeX/*/figs/ and ARE tracked
Code/figs/
Code/data/combo/plots/

# tests & smokes, merge/collect utilities
Code/test_*.py
Code/smoke_*.py
Code/data/merge_collected.py
Code/data/combine_celeba_sources.py

# data: durable CSV artifacts are tracked; backups/staging are not
Code/data/_*
Code/data/*.tgz

# logs & backups
logs/
*.log
*.bak*

# (was: MAIN.tex, code-only release. The repo now carries the paper sources too;
# the unanchored rule also matched UAI/main.tex on case-insensitive filesystems.)

# box-specific ops scripts (one-off fills, watchdogs, per-host launchers)
*.sh
!run_et_experiments.sh

# local-only scratch
*.local
vpn.txt

